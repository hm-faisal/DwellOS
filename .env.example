# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# ==========================================
# PostgreSQL Database (Neon / Prisma 8)
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ==========================================
# Redis Configuration (Redis Cloud / Local)
# ==========================================
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=doctor-black-town-52081.db.redis.io
REDIS_PORT=17960
REDIS_DB=0
REDIS_KEY_PREFIX=dwellos:

# ==========================================
# Cloudinary Configuration
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_KEY_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=dwellos

# ==========================================
# Nodemailer (SMTP) Configuration
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=your_email@gmail.com
SMTP_SENDER=your_email@gmail.com
SMTP_PASSWORD="your_app_password"

# ==========================================
# Authentication & JWT
# ==========================================
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# Stripe Payments Configuration
# ==========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
