model User {
  id                           String                  @id(map: "user_pkey")
  createdAt                    Timestamptz             @default(now())
  email                        String                  @unique(map: "user_email_key")
  name                         String
  password                     String
  phone                        String?
  role                         String                  @default("TENANT")
  status                       String                  @default("ACTIVE")
  stripeAccountId              String?
  stripeCustomerId             String?
  updatedAt                    Timestamptz             @default(now())
  applications                 Application[]
  billShares                   BillShare[]
  disputes                     Dispute[]
  documentAuditLogs            DocumentAuditLog[]
  documentSignatures           DocumentSignature[]
  leaseTenants                 LeaseTenant[]
  maintenanceRequests          MaintenanceRequest[]
  notifications                Notification[]
  notificationPreference       NotificationPreference?
  payments                     Payment[]
  properties                   Property[]
  propertyManagers             PropertyManager[]
  roommateApprovals            RoommateApproval[]
  roommateProfile              RoommateProfile?
  savedSearches                SavedSearch[]
  verifications                Verification[]
  viewingRequests              ViewingRequest[]
  roommateMatches              RoommateMatch[]         @relation(name: "roommateMatch_user1Id_fkey")
  roommateMatchesRoommateMatch RoommateMatch[]         @relation(name: "roommateMatch_user2Id_fkey")

  @@check(expression: "(role = ANY (ARRAY['TENANT'::text, 'OWNER'::text, 'ADMIN'::text]))", map: "user_role_check_0ed2480f")
  @@check(expression: "(status = ANY (ARRAY['ACTIVE'::text, 'SUSPENDED'::text, 'BANNED'::text]))", map: "user_status_check_18a7fd43")
  @@map("user")
}

