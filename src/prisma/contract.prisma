}

model Verification {
  id          String      @id(map: "verification_pkey")
  createdAt   Timestamptz @default(now())
  data        String?
  documentUrl String?
  notes       String?
  reviewerId  String?
  status      String      @default("PENDING")
  _type       String      @map("type")
  updatedAt   Timestamptz @default(now())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "verification_userId_fkey")

  @@index([userId], name: "verification_userId_idx")
  @@check(expression: "(status = ANY (ARRAY['PENDING'::text, 'IN_REVIEW'::text, 'VERIFIED'::text, 'REJECTED'::text]))", map: "verification_status_check_7362ec11")
  @@check(expression: "(type = ANY (ARRAY['IDENTITY'::text, 'INCOME'::text, 'EMPLOYMENT'::text, 'REFERENCE_CHECK'::text]))", map: "verification_type_check_2383abb9")
  @@map("verification")
}

model ViewingRequest {
  id            String       @id(map: "viewingRequest_pkey")
  alternateDate Timestamptz?
  createdAt     Timestamptz  @default(now())
  notes         String?
  preferredDate Timestamptz
  roomId        String
  status        String       @default("REQUESTED")
  tenantId      String
  _type         String       @default("IN_PERSON") @map("type")
  updatedAt     Timestamptz  @default(now())
  room          Room         @relation(fields: [roomId], references: [id], onDelete: Cascade, map: "viewingRequest_roomId_fkey")
  tenant        User         @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "viewingRequest_tenantId_fkey")

  @@index([roomId], name: "viewingRequest_roomId_idx")
  @@index([tenantId], name: "viewingRequest_tenantId_idx")
  @@check(expression: "(status = ANY (ARRAY['REQUESTED'::text, 'CONFIRMED'::text, 'ALTERNATE_PROPOSED'::text, 'DECLINED'::text, 'COMPLETED'::text, 'CANCELLED'::text, 'NO_SHOW'::text]))", map: "viewingRequest_status_check_ba1fa1b3")
  @@check(expression: "(type = ANY (ARRAY['IN_PERSON'::text, 'VIRTUAL'::text]))", map: "viewingRequest_type_check_004541db")
  @@map("viewingRequest")
}
